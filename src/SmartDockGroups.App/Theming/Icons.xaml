    <StreamGeometry x:Key="IconStyleAppFolder">M5 5h5v5H5z M14 5h5v5h-5z M5 14h5v5H5z M14 14h5v5h-5z</StreamGeometry>

    <!-- file commands -->
    <StreamGeometry x:Key="IconMore">M5.2 12a0.8 0.8 0 1 0 1.6 0 0.8 0.8 0 1 0-1.6 0z M11.2 12a0.8 0.8 0 1 0 1.6 0 0.8 0.8 0 1 0-1.6 0z M17.2 12a0.8 0.8 0 1 0 1.6 0 0.8 0.8 0 1 0-1.6 0z</StreamGeometry>
    <StreamGeometry x:Key="IconFolderOpen">M3 8a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v1H6.5L3 17z M3 17l3.5-6H22l-3.5 6z</StreamGeometry>
    <StreamGeometry x:Key="IconShield">M12 3l7 3v5.5c0 4.3-3 7.2-7 8.5-4-1.3-7-4.2-7-8.5V6z</StreamGeometry>
