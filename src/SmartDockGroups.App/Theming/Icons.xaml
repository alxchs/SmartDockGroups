    <StreamGeometry x:Key="IconProperties">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 11v5 M12 7.5v.5</StreamGeometry>

    <!-- app -->
    <StreamGeometry x:Key="IconSettings">M12 9.2a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6z M19.4 15a1.5 1.5 0 0 0 .3 1.7l.1.1a1.8 1.8 0 1 1-2.5 2.5l-.1-.1a1.5 1.5 0 0 0-2.5 1v.3a1.8 1.8 0 1 1-3.6 0V20a1.5 1.5 0 0 0-2.5-1l-.1.1a1.8 1.8 0 1 1-2.5-2.5l.1-.1a1.5 1.5 0 0 0-1-2.5H5a1.8 1.8 0 1 1 0-3.6H5.2a1.5 1.5 0 0 0 1-2.5l-.1-.1a1.8 1.8 0 1 1 2.5-2.5l.1.1a1.5 1.5 0 0 0 2.5-1V4a1.8 1.8 0 1 1 3.6 0v.2a1.5 1.5 0 0 0 2.5 1l.1-.1a1.8 1.8 0 1 1 2.5 2.5l-.1.1a1.5 1.5 0 0 0 1 2.5H20a1.8 1.8 0 1 1 0 3.6h-.2a1.5 1.5 0 0 0-1.4.9z</StreamGeometry>
    <StreamGeometry x:Key="IconPower">M12 4v8 M7.5 6.8a7 7 0 1 0 9 0</StreamGeometry>
    <StreamGeometry x:Key="IconStartup">M12 20V7 M6 13l6-6 6 6 M5 4h14</StreamGeometry>

</ResourceDictionary>
