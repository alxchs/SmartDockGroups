<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        One stroked line-icon set, drawn on a 24x24 grid with the same weight and cap
        style IGCParam uses, so a command means the same thing in both tools. Every
        geometry here is outline only: they are stroked at render time in the caller's
        colour, never filled.
    -->

    <sys:Double x:Key="IconStrokeThickness">1.7</sys:Double>
    <sys:Double x:Key="IconNominalSize">24</sys:Double>

    <!-- create / duplicate / edit -->
    <StreamGeometry x:Key="IconAdd">M12 5v14M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IconDuplicate">M11 9h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1z M15 5H6a2 2 0 0 0-2 2v9</StreamGeometry>
    <StreamGeometry x:Key="IconRename">M4 20h4l10-10-4-4L4 16z M14 6l4 4</StreamGeometry>
    <StreamGeometry x:Key="IconDelete">M5 7h14M9 7V5h6v2M7 7l1 13h8l1-13</StreamGeometry>

    <!-- containers -->
    <StreamGeometry x:Key="IconFolder">M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5</StreamGeometry>
    <StreamGeometry x:Key="IconOpenExternal">M14 3h7v7 M21 3l-9 9 M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5</StreamGeometry>

    <!-- direction -->
    <StreamGeometry x:Key="IconUp">M12 19V6M6 12l6-6 6 6</StreamGeometry>
    <StreamGeometry x:Key="IconDown">M12 5v13M6 12l6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconBack">M19 12H5M12 19l-7-7 7-7</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9 6l6 6-6 6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronUp">M6 15l6-6 6 6</StreamGeometry>

    <!-- state -->
    <StreamGeometry x:Key="IconCheck">M5 13l4 4L19 7</StreamGeometry>
    <StreamGeometry x:Key="IconLock">M6 11h12v9H6z M9 11V8a3 3 0 0 1 6 0v3</StreamGeometry>

    <!-- arrangement -->
    <StreamGeometry x:Key="IconGrid">M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z</StreamGeometry>
    <StreamGeometry x:Key="IconSort">M4 7h13M4 12h9M4 17h5</StreamGeometry>
    <StreamGeometry x:Key="IconIconSize">M4 10V4h6 M20 14v6h-6 M4 4l6 6 M20 20l-6-6</StreamGeometry>
    <StreamGeometry x:Key="IconMove">M12 2v20M2 12h20 M9 5l3-3 3 3 M9 19l3 3 3-3 M5 9l-3 3 3 3 M19 9l3 3-3 3</StreamGeometry>
    <StreamGeometry x:Key="IconGather">M4 4h5v5H4z M15 4h5v5h-5z M4 15h5v5H4z M15 15h5v5h-5z M10 12h4M12 10v4</StreamGeometry>

    <!-- appearance -->
    <StreamGeometry x:Key="IconColor">M12 3s6 6.6 6 10a6 6 0 0 1-12 0c0-3.4 6-10 6-10z</StreamGeometry>
    <StreamGeometry x:Key="IconImage">M4 5h16v14H4z M4 16l4.5-4.5 3.5 3.5 3-3L20 17 M9 9.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z</StreamGeometry>
    <StreamGeometry x:Key="IconOpacity">M12 3a9 9 0 0 0 0 18z M12 3a9 9 0 0 1 0 18</StreamGeometry>
    <StreamGeometry x:Key="IconBadge">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 8v4M12 15.5v.5</StreamGeometry>

    <!-- layout modes -->
