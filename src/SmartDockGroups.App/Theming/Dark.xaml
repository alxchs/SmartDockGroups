<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#252526" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#3D7EB8" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#4C8FCC" />
    <SolidColorBrush x:Key="AppControlBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="AppControlHoverBrush" Color="#3A3A3D" />
</ResourceDictionary>
