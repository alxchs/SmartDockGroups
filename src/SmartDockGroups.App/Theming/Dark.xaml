<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette shared with IGCParam, so the two tools read as one family. -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#262626" />
    <SolidColorBrush x:Key="AppSurface2Brush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="AppSurface3Brush" Color="#333333" />

    <SolidColorBrush x:Key="AppBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#525252" />

    <SolidColorBrush x:Key="AppTextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="AppTextFaintBrush" Color="#8F8F8F" />

    <SolidColorBrush x:Key="AppAccentBrush" Color="#4AA3F0" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#6CB6F5" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1E3A52" />

    <SolidColorBrush x:Key="AppDangerBrush" Color="#F26B62" />
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#3A1F1D" />

    <!-- Kept for the controls that still speak the older names. -->
    <SolidColorBrush x:Key="AppControlBackgroundBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="AppControlHoverBrush" Color="#333333" />

    <Color x:Key="AppShadowColor">#000000</Color>
</ResourceDictionary>
