<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette shared with IGCParam, so the two tools read as one family. -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSurface2Brush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="AppSurface3Brush" Color="#F0F0F0" />

    <SolidColorBrush x:Key="AppBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#C8C8C8" />

    <SolidColorBrush x:Key="AppTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#616161" />
    <SolidColorBrush x:Key="AppTextFaintBrush" Color="#8A8A8A" />

    <SolidColorBrush x:Key="AppAccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#115EA3" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E8F1FB" />

    <SolidColorBrush x:Key="AppDangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FDECEB" />

    <!-- Kept for the controls that still speak the older names. -->
    <SolidColorBrush x:Key="AppControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppControlHoverBrush" Color="#F0F0F0" />

    <Color x:Key="AppShadowColor">#7A000000</Color>
</ResourceDictionary>
