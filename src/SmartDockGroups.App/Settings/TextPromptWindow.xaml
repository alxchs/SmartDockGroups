<theming:ModernWindow x:Class="SmartDockGroups.App.Settings.TextPromptWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:theming="clr-namespace:SmartDockGroups.App.Theming"
                      xmlns:loc="clr-namespace:SmartDockGroups.App.Localization"
                      Title="{loc:Loc common.appName}"
                      Width="400"
                      SizeToContent="Height"
                      WindowStartupLocation="CenterOwner"
                      ResizeMode="NoResize"
                      ShowInTaskbar="False">
    <!--
        The window shell already supplies its own 16px content padding and the 14px
        shadow gutter, so this panel adds no margin of its own; the previous fixed
        height fought both and pushed the buttons out of view.
    -->
    <StackPanel>
        <TextBlock x:Name="PromptText" Style="{StaticResource AppFieldLabel}" />
        <TextBox x:Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc common.ok}"
                    Style="{StaticResource AppPrimaryButton}"
                    IsDefault="True"
                    Click="OnOkClick"
                    Margin="0,0,8,0" />
            <Button Content="{loc:Loc common.cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</theming:ModernWindow>
