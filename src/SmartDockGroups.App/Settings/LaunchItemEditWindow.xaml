<Window x:Class="SmartDockGroups.App.Settings.LaunchItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item do menu"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Nome" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

        <TextBlock Text="Tipo" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

        <TextBlock Text="Destino" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="TargetBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" />
        <Button Content="Procurar..." Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" Click="OnBrowseClick" />

        <TextBlock Text="Argumentos" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="ArgumentsBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

        <TextBlock Text="Diretório de trabalho" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="WorkingDirectoryBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

        <TextBlock Text="Modo de execução" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox x:Name="ExecutionModeBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />

        <TextBlock Text="Ícone personalizado" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="IconOverrideBox" Grid.Row="6" Grid.Column="1" Margin="0,0,8,8" />
        <Button Content="Procurar..." Grid.Row="6" Grid.Column="2" Margin="0,0,0,8" Click="OnBrowseIconClick" />

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClick" Margin="0,0,8,0" />
            <Button Content="Cancelar" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
