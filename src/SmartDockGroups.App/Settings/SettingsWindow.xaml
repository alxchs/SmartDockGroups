<theming:ModernWindow x:Class="SmartDockGroups.App.Settings.SettingsWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:theming="clr-namespace:SmartDockGroups.App.Theming"
                      xmlns:loc="clr-namespace:SmartDockGroups.App.Localization"
                      Title="{loc:Loc settings.title}"
                      Width="640" SizeToContent="Height"
                      ResizeMode="CanMinimize"
                      WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <GroupBox Header="{loc:Loc settings.appearance}" DockPanel.Dock="Top" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc settings.theme}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="AppThemeBox" Width="140" Margin="0,0,20,0" ItemTemplate="{StaticResource AppLabelItemTemplate}" SelectedValuePath="Mode" />
                <TextBlock Text="{loc:Loc settings.language}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguageBox" Width="160" ItemTemplate="{StaticResource AppLabelItemTemplate}" SelectedValuePath="Code" />
            </WrapPanel>
        </GroupBox>
        <GroupBox Header="{loc:Loc settings.behavior}" DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc settings.openMenuWith}" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <ComboBox x:Name="ClickModeBox" Width="140" Margin="0,0,20,0" ItemTemplate="{StaticResource AppLabelItemTemplate}" SelectedValuePath="Mode" />
                    <CheckBox x:Name="HotkeyEnabledBox" Content="{loc:Loc settings.globalHotkey}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox x:Name="HotkeyCtrlBox" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <CheckBox x:Name="HotkeyAltBox" Content="Alt" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <CheckBox x:Name="HotkeyShiftBox" Content="Shift" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <CheckBox x:Name="HotkeyWinBox" Content="Win" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="HotkeyKeyBox" Width="80" />
                </WrapPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="RestoreHotkeyEnabledBox" Content="{loc:Loc settings.restoreGroupsHotkey}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox x:Name="RestoreHotkeyCtrlBox" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <CheckBox x:Name="RestoreHotkeyAltBox" Content="Alt" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <CheckBox x:Name="RestoreHotkeyShiftBox" Content="Shift" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <CheckBox x:Name="RestoreHotkeyWinBox" Content="Win" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="RestoreHotkeyKeyBox" Width="80" />
                </WrapPanel>
                <TextBlock Text="{loc:Loc settings.restoreGroupsHotkeyHint}" Style="{StaticResource AppHintText}" Margin="0,6,0,0" />
            </StackPanel>
        </GroupBox>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Loc settings.export}" Width="96" Margin="0,0,8,0" Click="OnExportClick" />
            <Button Content="{loc:Loc settings.import}" Width="96" Margin="0,0,16,0" Click="OnImportClick" />
            <Button Content="{loc:Loc settings.save}" Width="96" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button Content="{loc:Loc settings.close}" Width="96" Click="OnCloseClick" />
        </StackPanel>
    </DockPanel>
</theming:ModernWindow>
