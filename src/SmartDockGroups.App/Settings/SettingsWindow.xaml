<Window x:Class="SmartDockGroups.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartDockGroups - Configurações"
        Width="560" Height="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <GroupBox Header="Comportamento" DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="4">
                <TextBlock Text="Abrir menu com" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ClickModeBox" Width="140" Margin="0,0,20,0" DisplayMemberPath="Label" SelectedValuePath="Mode" />
                <CheckBox x:Name="HotkeyEnabledBox" Content="Atalho global" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox x:Name="HotkeyCtrlBox" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,6,0" />
                <CheckBox x:Name="HotkeyAltBox" Content="Alt" VerticalAlignment="Center" Margin="0,0,6,0" />
                <CheckBox x:Name="HotkeyShiftBox" Content="Shift" VerticalAlignment="Center" Margin="0,0,6,0" />
                <CheckBox x:Name="HotkeyWinBox" Content="Win" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="HotkeyKeyBox" Width="70" />
            </StackPanel>
        </GroupBox>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Nova categoria" Padding="8,4" Margin="0,0,8,0" Click="OnAddCategoryClick" />
            <Button Content="Novo item" Padding="8,4" Margin="0,0,8,0" Click="OnAddItemClick" />
            <Button Content="Editar" Padding="8,4" Margin="0,0,8,0" Click="OnEditClick" />
            <Button Content="Excluir" Padding="8,4" Margin="0,0,8,0" Click="OnDeleteClick" />
            <Button Content="Tema..." Padding="8,4" Click="OnEditThemeClick" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Exportar..." Width="90" Padding="0,4" Margin="0,0,8,0" Click="OnExportClick" />
            <Button Content="Importar..." Width="90" Padding="0,4" Margin="0,0,16,0" Click="OnImportClick" />
            <Button Content="Salvar" Width="90" Padding="0,4" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button Content="Fechar" Width="90" Padding="0,4" Click="OnCloseClick" />
        </StackPanel>
        <TreeView x:Name="MenuTree"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="OnTreeMouseLeftButtonDown"
                  PreviewMouseMove="OnTreeMouseMove"
                  DragOver="OnTreeDragOver"
                  Drop="OnTreeDrop" />
    </DockPanel>
</Window>
