<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds nuget.org mapping for the self-contained publish runtime packs, on top
  of the machine-wide NuGet.Config (which maps a curated allowlist to
  nuget.org for other projects and does not include these). Scoped to this
  repository only — never touches the global config, which other projects on
  this machine rely on as-is.
-->
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETCore.App.Runtime.*" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.*" />
      <package pattern="Microsoft.AspNetCore.App.Runtime.*" />
      <package pattern="Microsoft.NETCore.App.Host.*" />
      <package pattern="Microsoft.NETCore.App.Ref" />
      <package pattern="Microsoft.WindowsDesktop.App.Ref" />
      <package pattern="Microsoft.AspNetCore.App.Ref" />
      <package pattern="runtime.win-x64.*" />
      <!-- Test stack, for tests/SmartDockGroups.Tests. Same reasoning as the runtime packs:
           the machine-wide allowlist does not carry these, and without the mapping
           `dotnet restore` refuses them with NU1100. -->
      <package pattern="xunit*" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.TestPlatform.*" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Newtonsoft.Json" />
    </packageSource>
  </packageSourceMapping>
</configuration>
